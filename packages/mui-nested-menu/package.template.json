{
    "name": "mui-nested-menu",
    "description": "Infinitely deep nested menu items for MUI 5, 6, 7 and 9.",
    "version": "4.1.0",
    "homepage": "https://mui-nested-menu.vercel.app/",
    "repository": {
        "type": "git",
        "url": "https://github.com/steviebuilds/mui-nested-menu.git"
    },
    "bugs": {
        "url": "https://github.com/steviebuilds/mui-nested-menu/issues"
    },
    "main": "./index.js",
    "module": "./index.mjs",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.mts",
                "default": "./index.mjs"
            },
            "require": {
                "types": "./index.d.ts",
                "default": "./index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "keywords": ["design", "material", "mui", "react", "ui"],
    "author": "Steve Richardson",
    "license": "MIT",
    "peerDependencies": {
        "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
        "@emotion/react": "^11.5.0",
        "@emotion/styled": "^11.3.0",
        "@types/react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "@emotion/react": {
            "optional": true
        },
        "@emotion/styled": {
            "optional": true
        }
    }
}
